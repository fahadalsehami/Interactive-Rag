# Copy to .streamlit/secrets.toml and fill in what you use. The app reads these as environment variables.
# Do not put AWS access keys here: use `aws configure`, AWS IAM Identity Center or an IAM role instead.
AWS_REGION = "us-east-1"

# Claude model or inference profile on Amazon Bedrock (optional)
BEDROCK_MODEL_ID = "global.anthropic.claude-sonnet-4-6"

# Retrieval (optional). Set one: an Amazon Bedrock Knowledge Base ID (10 characters) ...
KNOWLEDGE_BASE_ID = ""
# ... or, for accounts that already use Amazon Kendra, an index ID or the stack made from kendra-template.yaml
KENDRA_INDEX_ID = ""
KENDRA_STACK_NAME = "clinical-rag-kendra"
